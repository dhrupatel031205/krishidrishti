# Optional: Set a free Groq API key to enable LLM-powered Hindi/Gujarati assistant
# Get your free key at: https://console.groq.com
LLM_API_KEY=your_groq_api_key_here

# MongoDB Atlas connection string
# Get a free cluster at: https://cloud.mongodb.com
MONGODB_URI=mongodb+srv://<user>:<password>@cluster0.xxxxx.mongodb.net/krishidrishti?retryWrites=true&w=majority

# JWT secret for auth tokens (any random string)
JWT_SECRET=your_jwt_secret_here

# Optional overrides (defaults shown)
# LLM_BASE_URL=https://api.groq.com/openai/v1
# LLM_MODEL=llama-3.3-70b-versatile
