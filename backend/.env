# Groq API key — get a free key at https://console.groq.com
LLM_API_KEY=<paste_your_new_groq_key_here>

# MongoDB Atlas connection string — get a free cluster at https://cloud.mongodb.com
# Format: mongodb+srv://<user>:<password>@cluster0.xxxxx.mongodb.net/krishidrishti?retryWrites=true&w=majority
MONGODB_URI=<paste_your_mongodb_uri_here>

# JWT secret — any long random string
JWT_SECRET=<paste_your_jwt_secret_here>

# Optional overrides
# LLM_BASE_URL=https://api.groq.com/openai/v1
# LLM_MODEL=llama-3.3-70b-versatile
